# 複製成 .env.app 後填入本機值
# 用 docker-compose -f docker-compose-app.yml --env-file .env.app up -d 啟動

# --- Image 版本 ---
# 留空使用 latest，或指定 commit SHA
BACKEND_TAG=
FRONTEND_TAG=

# --- 後端 ---
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
AUTH_MODE=jwt
# dev 模式預設玩家 UUID（AUTH_MODE=dev 時才需要）
DEV_DEFAULT_USER_ID=

# CORS 允許的前端網址（部署時改為實際前端網址）
CORS_ALLOW_ORIGINS=http://localhost:8080

# --- LLM ---
LLM_PROVIDER=fake
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=

# --- Embedding（games_advisor） ---
GAMES_ADVISOR_EMBEDDING_PROVIDER=fake
GAMES_ADVISOR_EMBEDDING_ENDPOINT=
GAMES_ADVISOR_EMBEDDING_API_KEY=
GAMES_ADVISOR_EMBEDDING_MODEL=

# --- Embedding（rules_qa） ---
RULES_QA_EMBEDDING_PROVIDER=fake
RULES_QA_EMBEDDING_ENDPOINT=
RULES_QA_EMBEDDING_API_KEY=
RULES_QA_EMBEDDING_MODEL=

# --- OCR ---
OCR_PROVIDER=fake
OCR_DI_ENDPOINT=

# --- Storage ---
STORAGE_PROVIDER=fake

# --- 前端 port ---
FRONTEND_PORT=8080
