# 複製成 .env 後填入本機值。.env 不會被提交；這裡只寫欄位名與說明，不寫值。

# --- PostgreSQL（docker-compose 與後端共用） ---
# 資料庫帳號、密碼、名稱（docker-compose 建立資料庫時使用）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 本機對外埠號
POSTGRES_PORT=
# 後端連線字串，格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# --- 身分驗證 ---
# dev：以 X-Dev-User 標頭取得使用者，並啟用 /api/v1/dev/...（只限本機開發）
# jwt：驗證 Bearer token，dev 路由不會掛載。正式環境一律使用 jwt
AUTH_MODE=
# AUTH_MODE=dev 且未帶 X-Dev-User 時使用的預設玩家 UUID（選填，程式內有預設值）
DEV_DEFAULT_USER_ID=

# --- CORS ---
# 允許呼叫 API 的前端網址，逗號分隔，例如 http://localhost:5000,https://example.com
# 未設定時預設為 http://localhost:5000（本機 Flutter Web 固定的 port）；部署時必須設成實際的前端網址
CORS_ALLOW_ORIGINS=

# --- LLM（全域，所有 domain 共用） ---
# fake：測試用，沒有設定模型（需要模型的 API 回 503）
# cloud：Azure OpenAI（尚未實作）；local：地端（尚未實作）
LLM_PROVIDER=
# Azure OpenAI 的 v1 端點，格式：https://<資源名稱>.openai.azure.com/openai/v1/
LLM_ENDPOINT=
# 雲端模型金鑰（LLM_PROVIDER=cloud 時使用）
LLM_API_KEY=
# 對話模型的部署名稱
LLM_MODEL=
# 批次指令用的部署名稱（選填，留空就用 LLM_MODEL）
LLM_BATCH_MODEL=
# 推理強度：none、low、medium、high、xhigh、max；留空用模型預設，非推理模型要留空。填錯會啟動失敗
LLM_REASONING_EFFORT=
# 單次請求逾時秒數（選填，預設 30）
LLM_TIMEOUT_SECONDS=

# --- 全域向量維度 ---
# 向量欄位維度，由 embedding 模型決定，不要寫死在程式中。games_advisor 不讀這個欄位
EMBEDDING_DIM=

# --- games_advisor 的 embedding（只給 games_advisor 用，沒填不會退回任何全域設定） ---
# fake（預設）或 cloud（尚未實作）
GAMES_ADVISOR_EMBEDDING_PROVIDER=
# Azure OpenAI 的 v1 端點，目前和 LLM_ENDPOINT 填一樣的值
GAMES_ADVISOR_EMBEDDING_ENDPOINT=
GAMES_ADVISOR_EMBEDDING_API_KEY=
# embedding 的部署名稱，也會記在每個向量上，用來偵測換了模型
GAMES_ADVISOR_EMBEDDING_MODEL=
# 向量長度，也是 games_advisor 向量欄位的維度（選填，預設 1536）
GAMES_ADVISOR_EMBEDDING_DIM=

# --- MQTT（Mosquitto） ---
MQTT_HOST=
MQTT_PORT=
# 本機 broker 允許匿名可留空；部署到雲端時必須設定帳密
MQTT_USERNAME=
MQTT_PASSWORD=
