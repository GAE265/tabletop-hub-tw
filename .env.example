# 複製成 .env 後填入本機值。.env 不會被提交；這裡只寫欄位名與說明，不寫值。

# --- PostgreSQL（docker-compose 與後端共用） ---
# 資料庫帳號、密碼、名稱（docker-compose 建立資料庫時使用）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 本機對外埠號
POSTGRES_PORT=
# 後端連線字串，格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# --- 身分驗證 ---
# dev：以 X-Dev-User 標頭取得使用者，並啟用 /api/v1/dev/...（只限本機開發）
# jwt：驗證 Bearer token，dev 路由不會掛載。正式環境一律使用 jwt
AUTH_MODE=
# AUTH_MODE=dev 且未帶 X-Dev-User 時使用的預設玩家 UUID（選填，程式內有預設值）
DEV_DEFAULT_USER_ID=

# --- CORS ---
# 允許呼叫 API 的前端網址，逗號分隔，例如 http://localhost:5000,https://example.com
# 未設定時預設為 http://localhost:5000（本機 Flutter Web 固定的 port）；部署時必須設成實際的前端網址
CORS_ALLOW_ORIGINS=

# --- LLM / Embedding ---
# 目前支援：fake（固定回覆，供測試）。cloud、local 尚未實作
LLM_PROVIDER=
# 雲端模型金鑰（LLM_PROVIDER=cloud 時使用，目前未使用）
LLM_API_KEY=
# 向量欄位維度，由 embedding 模型決定，不要寫死在程式中
EMBEDDING_DIM=

# --- MQTT（Mosquitto） ---
MQTT_HOST=
MQTT_PORT=
# 本機 broker 允許匿名可留空；部署到雲端時必須設定帳密
MQTT_USERNAME=
MQTT_PASSWORD=
