# 複製成 .env 後填入本機值。.env 不會被提交；這裡只寫欄位名與說明，不寫值。

# --- PostgreSQL（docker-compose 與後端共用） ---
# 資料庫帳號、密碼、名稱（docker-compose 建立資料庫時使用）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 本機對外埠號
POSTGRES_PORT=
# 後端連線字串，格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# --- 身分驗證 ---
# dev：以 X-Dev-User 標頭取得使用者，並啟用 /api/v1/dev/...（只限本機開發）
# jwt：驗證 Bearer token，dev 路由不會掛載。正式環境一律使用 jwt
AUTH_MODE=
# AUTH_MODE=dev 且未帶 X-Dev-User 時使用的預設玩家 UUID（選填，程式內有預設值）
DEV_DEFAULT_USER_ID=

# --- CORS ---
# 允許呼叫 API 的前端網址，逗號分隔，例如 http://localhost:5000,https://example.com
# 未設定時預設為 http://localhost:5000（本機 Flutter Web 固定的 port）；部署時必須設成實際的前端網址
CORS_ALLOW_ORIGINS=

# --- LLM（全域，所有 domain 共用） ---
# fake：測試用，沒有設定模型（需要模型的 API 回 503）
# cloud：Azure OpenAI（要填 LLM_ENDPOINT、LLM_API_KEY、LLM_MODEL，缺一個就啟動失敗）；local：地端（尚未實作）
LLM_PROVIDER=
# Azure OpenAI 的 v1 端點，格式：https://<資源名稱>.openai.azure.com/openai/v1/
LLM_ENDPOINT=
# 雲端模型金鑰（LLM_PROVIDER=cloud 時使用）
LLM_API_KEY=
# 對話模型的部署名稱
LLM_MODEL=
# 批次指令用的部署名稱（選填，留空就用 LLM_MODEL）
LLM_BATCH_MODEL=
# 推理強度：none、low、medium、high、xhigh、max；留空用模型預設，非推理模型要留空。填錯會啟動失敗
LLM_REASONING_EFFORT=
# 單次請求逾時秒數（選填，預設 30）
LLM_TIMEOUT_SECONDS=

# --- 全域向量維度 ---
# 向量欄位維度，由 embedding 模型決定，不要寫死在程式中。games_advisor 不讀這個欄位
EMBEDDING_DIM=

# --- games_advisor 的 embedding（只給 games_advisor 用，沒填不會退回任何全域設定） ---
# fake（預設）或 cloud（Azure OpenAI，要填下面的 ENDPOINT、API_KEY、MODEL，缺一個就啟動失敗）
GAMES_ADVISOR_EMBEDDING_PROVIDER=
# Azure OpenAI 的 v1 端點，目前和 LLM_ENDPOINT 填一樣的值
GAMES_ADVISOR_EMBEDDING_ENDPOINT=
GAMES_ADVISOR_EMBEDDING_API_KEY=
# embedding 的部署名稱，也會記在每個向量上，用來偵測換了模型
GAMES_ADVISOR_EMBEDDING_MODEL=
# 向量長度，也是 games_advisor 向量欄位的維度（選填，預設 1536）
GAMES_ADVISOR_EMBEDDING_DIM=

# --- rules_qa 的 embedding（只給規則問答用，沒填不會退回任何全域設定） ---
# fake（預設）或 cloud（Azure OpenAI，要填下面的 ENDPOINT、API_KEY、MODEL，缺一個就啟動失敗）
RULES_QA_EMBEDDING_PROVIDER=
# Azure OpenAI 的 v1 端點
RULES_QA_EMBEDDING_ENDPOINT=
RULES_QA_EMBEDDING_API_KEY=
# embedding 的部署名稱，也會記在每個段落上，用來偵測換了模型（換模型要重建索引）
RULES_QA_EMBEDDING_MODEL=
# 向量長度，也是 rules_qa_chunks.embedding 的維度（選填，預設 1536）
RULES_QA_EMBEDDING_DIM=

# --- 文字轉語音（影片生產器的旁白） ---
# fake（預設，產生靜音音檔）或 azure（Azure AI Speech）
TTS_PROVIDER=
# azure 時：語音資源的區域代碼，例如 eastasia（Azure 入口網站 → 語音資源 → 金鑰與端點）
TTS_REGION=
# azure 時：語音資源的金鑰（Key 1）
TTS_API_KEY=
# 預設聲音（選填，預設 zh-TW-YunJheNeural）
TTS_VOICE=

# --- 檔案儲存（影片生產器的素材照片、旁白與影片） ---
# fake（預設，存在記憶體）、local（存在本機資料夾，開發用）或 cloud（Azure Blob Storage）
STORAGE_PROVIDER=
# local 時：存放檔案的本機資料夾
STORAGE_LOCAL_DIR=
# local 時：回傳的檔案網址前綴，例如 http://localhost:8000/media
STORAGE_PUBLIC_BASE_URL=
# cloud 時：儲存體帳戶的連接字串（Azure 入口網站 → 儲存體帳戶 → 存取金鑰）
STORAGE_CONNECTION_STRING=
# cloud 時：容器名稱
STORAGE_CONTAINER=

# --- 規則影片的字型（本機指令輸出畫面用） ---
# 一般字重的字型檔完整路徑，例如 Windows 的微軟正黑體 C:\Windows\Fonts\msjh.ttc
# 兩個都沒填時改用 Pillow 內建字型（中文無法正確顯示），並印出警告
VIDEO_FONT_REGULAR=
# 粗體的字型檔完整路徑，例如 C:\Windows\Fonts\msjhbd.ttc（選填，沒填就用一般字重）
VIDEO_FONT_BOLD=
# .ttc 字型集合檔內要用第幾個字型（選填，預設 0）；.ttf／.otf 忽略
VIDEO_FONT_INDEX=
# ffmpeg 執行檔（選填，預設 ffmpeg，也就是從 PATH 找）；不在 PATH 時填完整路徑
FFMPEG_PATH=
# 背景音樂音量 0–1（選填，預設 0.25）；旁白出現時還會再自動壓低
VIDEO_MUSIC_VOLUME=

# --- MQTT（Mosquitto） ---
MQTT_HOST=
MQTT_PORT=
# 本機 broker 允許匿名可留空；部署到雲端時必須設定帳密
MQTT_USERNAME=
MQTT_PASSWORD=

# --- OCR 與視覺模型（規則書圖片入庫，integrations/ocr） ---
# 金鑰全部沿用上面的 LLM_API_KEY；端點各自獨立設定（Document Intelligence、視覺模型是不同網域）
# fake：測試用，沒有設定腳本時呼叫會回 503；cloud：Azure Document Intelligence + Azure OpenAI 視覺
# cloud 缺欄位時，需要它的 API 回 503 並指出缺哪個欄位
OCR_PROVIDER=
# Azure Document Intelligence 端點，格式：https://<資源名稱>.cognitiveservices.azure.com/
OCR_DI_ENDPOINT=
# 視覺模型端點（選填，留空用 LLM_ENDPOINT），格式同 LLM_ENDPOINT：https://<資源名稱>.openai.azure.com/openai/v1/
OCR_VISION_ENDPOINT=
# 視覺模型的部署名稱（選填，留空用 LLM_MODEL；必須是支援圖片輸入的部署）
OCR_VISION_MODEL=
# 視覺模型單次請求逾時秒數（選填，預設 120）
OCR_VISION_TIMEOUT_SECONDS=
