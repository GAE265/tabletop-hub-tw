FROM ghcr.io/cirruslabs/flutter:3.41.4

WORKDIR /build

COPY frontend/pubspec.yaml frontend/pubspec.lock ./
RUN flutter pub get --enforce-lockfile

COPY frontend/ ./
RUN dart run build_runner build --delete-conflicting-outputs

ARG API_BASE_URL=__API_BASE_URL__
RUN flutter build web \
    --debug \
    --dart-define=API_BASE_URL=$API_BASE_URL \
    --dart-define=SHOW_PROTOTYPES=true \
    --base-href=/

FROM nginx:alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=0 /build/build/web /usr/share/nginx/html
COPY docker/nginx/entrypoint.sh /docker-entrypoint.d/40-api-base-url.sh
RUN chmod +x /docker-entrypoint.d/40-api-base-url.sh

EXPOSE 80
